# Скопируйте в .env.local и заполните данными своего проекта Supabase
# (Supabase → Project Settings → API). Публичный (anon / publishable) ключ можно
# хранить в приложении. Ключ service_role и пароль базы сюда НЕ вписывать.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
